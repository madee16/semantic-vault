# Environment Configuration for SemanticVault

# Service
PROJECT_NAME="SemanticVault"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/semanticvault"
DB_ECHO=false

# API Key Security
# IMPORTANT: Generate a 32+ character random string for production
API_KEY_SALT="semanticvault-cryptographic-salt-change-in-production-min-32-chars"
DEFAULT_MONTHLY_QUOTA=10000
RATE_LIMIT_PER_MINUTE=60

# Local AI / Ollama Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TIMEOUT_SECONDS=60.0

# Embedding Model & Version Configuration
# Supported models:
# - embeddinggemma (dim: 768)
# - nomic-embed-text (dim: 768)
# - all-MiniLM-L6-v2 (dim: 384, fallback)
EMBEDDING_MODEL="embeddinggemma"
EMBEDDING_MODEL_VERSION="v1"
EMBEDDING_DIM=768

# Generative Model for Query Rewriting & Document Enrichment
CHAT_MODEL="llama3.2:1b"

# Chunking Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
